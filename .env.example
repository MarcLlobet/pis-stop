# Public values: they end up in the browser bundle and that is fine.
# Without them the app runs in demo-only mode.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: live location sharing during the event. A restricted-capability
# Ably key (publish/subscribe/presence on `location:*` only) is as public as
# the two values above. Without it, the feature stays hidden.
VITE_ABLY_KEY=

# Only used by `pnpm event:create` (never bundled).
APP_URL=https://marcllobet.github.io/pis-stop/

# Only used by `pnpm event:route`, on your computer. SECRET: never commit it,
# never prefix it with VITE_. Restrict it to the Routes API in Google Cloud.
GOOGLE_MAPS_API_KEY=
