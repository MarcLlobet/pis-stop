{
  "name": "pis-stop",
  "version": "0.2.0",
  "private": true,
  "description": "Mapa privat de fotos per a un correpisos entre amics. Xifrat i signat al navegador, sense backend.",
  "license": "MIT",
  "author": "Marc Llobet",
  "repository": "github:MarcLlobet/pis-stop",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=10.16"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:ts-only": "ts-only",
    "check": "pnpm check:ts-only && pnpm format:check && pnpm lint && pnpm typecheck && pnpm coverage",
    "manifest": "tsx scripts/build-manifest.ts dist",
    "map:extract": "tsx scripts/extract-map.ts",
    "map:metro": "tsx scripts/extract-metro.ts",
    "event:create": "tsx scripts/create-event.ts",
    "event:close": "tsx scripts/close-event.ts",
    "event:host": "tsx scripts/grant-host.ts",
    "event:wipe": "tsx scripts/wipe-event.ts",
    "event:export": "tsx scripts/export-event.ts",
    "event:route": "tsx scripts/plan-routes.ts"
  },
  "dependencies": {
    "@untitledui/icons": "^0.0.23",
    "ably": "^2.30.0",
    "leaflet": "^1.9.4",
    "protomaps-leaflet": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^9.0.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "jiti": "^2.7.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "ts-only": "^2.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
